---
type Props = {
  target: string;
};

const target = Astro.props.target;
---

<div
  class="flex flex-row justify-center items-center gap-1.5 xs:gap-2 sm:gap-4 text-center text-white w-full max-w-2xl mx-auto"
>
  <div
    class="bg-black/80 rounded-md flex flex-col items-center justify-center py-2 sm:py-3 px-1.5 sm:px-4 flex-1 min-w-0"
  >
    <span
      id="days"
      class="font-mono text-xl xs:text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight whitespace-nowrap"
      aria-live="polite">00</span
    >
    <span class="text-[10px] sm:text-xs uppercase tracking-wide text-gray-400 mt-0.5 sm:mt-1">days</span>
  </div>
  <div
    class="bg-black/80 rounded-md flex flex-col items-center justify-center py-2 sm:py-3 px-1.5 sm:px-4 flex-1 min-w-0"
  >
    <span
      id="hours"
      class="font-mono text-xl xs:text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight whitespace-nowrap"
      aria-live="polite">00</span
    >
    <span class="text-[10px] sm:text-xs uppercase tracking-wide text-gray-400 mt-0.5 sm:mt-1">hours</span>
  </div>
  <div
    class="bg-black/80 rounded-md flex flex-col items-center justify-center py-2 sm:py-3 px-1.5 sm:px-4 flex-1 min-w-0"
  >
    <span
      id="minutes"
      class="font-mono text-xl xs:text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight whitespace-nowrap"
      aria-live="polite">00</span
    >
    <span class="text-[10px] sm:text-xs uppercase tracking-wide text-gray-400 mt-0.5 sm:mt-1">min</span>
  </div>
  <div
    class="bg-black/80 rounded-md flex flex-col items-center justify-center py-2 sm:py-3 px-1.5 sm:px-4 flex-1 min-w-0"
  >
    <span
      id="seconds"
      class="font-mono text-xl xs:text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight whitespace-nowrap"
      aria-live="polite">00</span
    >
    <span class="text-[10px] sm:text-xs uppercase tracking-wide text-gray-400 mt-0.5 sm:mt-1">sec</span>
  </div>
</div>

<script is:inline define:vars={{ target }}>
  document.addEventListener("DOMContentLoaded", () => {
    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");

    const targetTime = new Date(target).getTime();

    const updateCountdown = () => {
      const currentTime = new Date().getTime();
      const diff = targetTime - currentTime;

      if (diff <= 0) {
        clearInterval(countdownInterval);
        daysEl.innerText = "00";
        hoursEl.innerText = "00";
        minutesEl.innerText = "00";
        secondsEl.innerText = "00";
        return;
      }

      const remainingDays = Math.floor(diff / (1000 * 60 * 60 * 24));
      const remainingHours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const remainingMinutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const remainingSeconds = Math.floor((diff % (1000 * 60)) / 1000);

      const formatNumber = (num) => String(num).padStart(2, "0");

      daysEl.innerText = formatNumber(remainingDays);
      hoursEl.innerText = formatNumber(remainingHours);
      minutesEl.innerText = formatNumber(remainingMinutes);
      secondsEl.innerText = formatNumber(remainingSeconds);

      daysEl.ariaLabel = `${remainingDays} days`;
      hoursEl.ariaLabel = `${remainingHours} hours`;
      minutesEl.ariaLabel = `${remainingMinutes} minutes`;
      secondsEl.ariaLabel = `${remainingSeconds} seconds`;
    };

    updateCountdown();
    const countdownInterval = setInterval(updateCountdown, 1000);
  });
</script>
