---
import Layout from "@/layouts/Layout.astro";
import { getHeaderLinks } from "@/lib/get-header-links";
import { getWrappedSdk } from "@/lib/get-wrapped-sdk";
import { Image } from "astro:assets";
import magicalCosplayConLogo from "@/images/magical_cosplay_con_logo.svg";
import magicalDisneyMarktLogo from "@/images/magical_disney_markt_logo.svg";
import magicalHobbyBeursLogo from "@/images/magical_hobby_beurs_logo.svg";

const sdk = getWrappedSdk();
const { data } = await sdk.Layout();
---

<Layout title={data.global?.siteName} description={data.global?.siteDescription} headerLinks={getHeaderLinks(data)}>
  <div
    class="md:absolute inset-0 z-0 bg-[url(/background.png)] bg-cover bg-no-repeat bg-fixed bg-center text-white min-h-screen w-screen"
  >
    <div class="flex items-center justify-center min-h-screen py-10 px-6 md:py-0 md:px-6">
      <div class="flex md:flex-row flex-col justify-center items-center gap-12 md:gap-8 w-full max-w-md md:max-w-7xl">
        <div class="flex flex-col items-center w-full md:max-w-[380px]">
          <a href="/cosplay-con" class="w-full flex justify-center">
            <Image
              src={magicalCosplayConLogo}
              class="hover:opacity-80 mb-6 max-w-full h-auto"
              height="300"
              width="480"
              alt="Magical Cosplay Con logo"
              widths={[240, 540, 720, magicalCosplayConLogo.width]}
            />
          </a>
          <a
            href="/cosplay-con"
            class="bg-gradient-to-r from-blue-800 to-indigo-900 hover:opacity-80 text-white font-bold px-5 py-2.5 rounded-full inline-block"
          >
            Enter
          </a>
        </div>

        <div class="flex flex-col items-center w-full md:max-w-[380px]">
          <a href="/disney-market" class="w-full flex justify-center">
            <Image
              src={magicalDisneyMarktLogo}
              class="hover:opacity-80 mb-6 max-w-full h-auto"
              height="300"
              width="480"
              alt="Magical Disney Markt logo"
              widths={[240, 540, 720, magicalDisneyMarktLogo.width]}
            />
          </a>
          <a
            href="/disney-market"
            class="bg-gradient-to-r from-blue-800 to-indigo-900 hover:opacity-80 text-white font-bold px-5 py-2.5 rounded-full inline-block"
          >
            Enter
          </a>
        </div>

        <div class="flex flex-col items-center w-full md:max-w-[380px]">
          <a href="/hobby-con" class="w-full flex justify-center">
            <Image
              src={magicalHobbyBeursLogo}
              class="hover:opacity-80 mb-6 max-w-full h-auto"
              height="300"
              width="480"
              alt="Magical Hobby Beurs Logo"
              widths={[240, 540, 720, magicalHobbyBeursLogo.width]}
            />
          </a>
          <a
            href="/hobby-con"
            class="bg-gradient-to-r from-blue-800 to-indigo-900 hover:opacity-80 text-white font-bold px-5 py-2.5 rounded-full inline-block"
          >
            Enter
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
